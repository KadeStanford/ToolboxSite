rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /analytics/{doc} {
      allow write: if true;
      allow read:  if request.auth != null;
    }
    match /shorts/{doc} {
      allow read: if true;
      allow write: if true;
    }
    match /pastes/{doc} {
      allow read: if true;
      allow write: if true;
    }
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
